library(tidyverse)
library(edgeR)
BiocManager::install("edgeR")
# Inspect the data
glimpse(counts)
(metadata)
counts <- read_csv("GSE80655_counts.csv")
metadata <- read_csv("GSE80655_metadata.csv")
glimpse(counts)
glimpse(metadata)
dim(counts)
dim(metadata)
# Convert count data to a matrix
counts_matrix <- counts %>%
column_to_rownames("gene_id") %>%
as.matrix()
# Check whether sample names match
all(colnames(counts_matrix) == metadata$description)
# Number of samples per diagnosis
metadata %>%
count(diagnosis)
# Number of samples per brain region
metadata %>%
count(brain_region)
# Number of samples per diagnosis and brain region
metadata %>%
count(diagnosis, brain_region)
ggplot(metadata, aes(x = diagnosis, fill = diagnosis)) +
geom_bar() +
theme_minimal() +
labs(
title = "Number of samples per diagnosis",
x = "Diagnosis",
y = "Number of samples"
) +
theme(legend.position = "none")
metadata
